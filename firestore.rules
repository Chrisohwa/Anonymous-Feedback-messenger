rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow anonymous users to create feedback documents
    match /feedback/{document} {
      allow create: if true;
      allow read: if false;
    }
    
    // Default rules - require authentication for other operations
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
